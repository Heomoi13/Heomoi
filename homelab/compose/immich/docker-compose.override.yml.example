# GIAI ĐOẠN 4b (khuyến nghị) — Đưa thumbnail và video encode của Immich về NVMe.
# Đặt file này cạnh docker-compose.yml của Immich với tên docker-compose.override.yml
# (nếu đã có file override thì GỘP phần volumes vào, không ghi đè).
#
# MEDIA_IN_CONTAINER: đường dẫn trong container mà UPLOAD_LOCATION đang được mount vào.
#   - Immich bản mới: /data
#   - Immich bản cũ : /usr/src/app/upload
# Hermes xác định bằng: docker inspect immich_server -f '{{range .Mounts}}{{.Source}} -> {{.Destination}}{{"\n"}}{{end}}'
services:
  immich-server:
    volumes:
      - /srv/fast/immich/thumbs:/data/thumbs
      - /srv/fast/immich/encoded-video:/data/encoded-video
