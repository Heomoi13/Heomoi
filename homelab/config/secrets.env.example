# /etc/homelab/secrets.env — quyền 600, chủ sở hữu root. KHÔNG commit file thật lên git.
# Có thể lấy lại token Telegram từ script cảnh báo SMART hiện có.

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# URL ping Healthchecks.io (dạng https://hc-ping.com/<uuid>). Người tạo check trên web rồi dán vào.
HC_SEED=
HC_BACKUP_LOCAL=
HC_BACKUP_MAC=
HC_MAINTAIN=
HC_MONITOR=
