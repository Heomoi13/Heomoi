# /etc/homelab/homelab.env — cấu hình homelab (KHÔNG chứa bí mật).
# Mọi giá trị CHANGE_ME phải được Hermes điền từ báo cáo khảo sát (giai đoạn 0)
# và được người xác nhận trước khi chạy giai đoạn tương ứng.

# ---------- NAS UGREEN DXP4800 ----------
NAS_IP=192.168.1.123
NAS_MAC=6c:1f:f7:ad:f9:20
NAS_SSH_USER=namdo
# Đường dẫn export NFS của share "data" (xác nhận bằng `showmount -e` và mount thử)
NAS_NFS_EXPORT=/volume1/data
# Thư mục con trong share chứa dữ liệu gốc (bản sao của /srv/nas)
NAS_HOMELAB_SUBDIR=homelab
# Thư mục con chứa dump DB và metadata
NAS_META_SUBDIR=homelab-meta
# Điểm mount NFS toàn share, chỉ dùng cho script (automount)
NAS_MOUNT=/mnt/nas-data
# Tuỳ chọn NFS. Nếu NAS không hỗ trợ 4.1 thì đổi vers=3
NFS_OPTS=vers=4.1,hard,noatime,rsize=1048576,wsize=1048576,timeo=600,retrans=2

# ---------- Mac mini M2 (bản sao thứ 3) ----------
# Alias SSH trong /root/.ssh/config (HostName = IP Tailscale 100.84.51.36, ổn định hơn IP LAN DHCP)
MAC_M2_HOST=mac-m2
MAC_M2_USER=CHANGE_ME
MAC_M2_BACKUP_DIR=/Volumes/Backup
# Ổ USB APFS "Backup" chỉ được mount lúc backup. Điền Volume UUID (diskutil info /Volumes/Backup)
MAC_BACKUP_VOLUME=CHANGE_ME

# ---------- Homeserver ----------
# Đường dẫn dữ liệu gốc mà container đang dùng. GIỮ NGUYÊN sau cutover
# (sau cutover, đường dẫn này là mount NFS từ NAS).
PRIMARY=/srv/nas
# Nơi ổ HDD 3TB được gắn (chỉ đọc) sau cutover
OLD_HDD_MOUNT=/mnt/old-hdd
# Partition của ổ Seagate 3TB, dạng /dev/disk/by-id/ata-ST3000DM003-..._SERIAL-part1
OLD_HDD_PART=CHANGE_ME
# Ổ 3TB sau khi format lại làm ổ backup
BACKUP_MOUNT=/srv/backup
# Thư mục trên SSD hệ thống (Crucial BX500)
FAST=/srv/fast
DUMP_DIR=/srv/fast/dumps

# ---------- Immich ----------
IMMICH_COMPOSE_DIR=CHANGE_ME
IMMICH_DB_CONTAINER=immich_postgres
# UPLOAD_LOCATION trên host (lấy từ .env của Immich)
IMMICH_UPLOAD_HOST=CHANGE_ME

# Các Postgres cần dump trước mỗi lần backup: "container:user container:user"
DB_DUMPS="immich_postgres:postgres"

# ---------- Cutover ----------
# Dịch vụ host đang giữ file trong /srv/nas, dừng trong lúc switch rồi chạy lại
CUTOVER_STOP_SERVICES="smbd cron"

# ---------- Backup (restic) ----------
RESTIC_PASSWORD_FILE=/etc/homelab/restic.pass
RESTIC_REPO_LOCAL=/srv/backup/restic
RESTIC_REPO_MAC=sftp:mac-m2:/Volumes/Backup/restic
# Các thư mục cần backup, cách nhau bằng dấu cách. Bổ sung thư mục compose/config sau giai đoạn 0.
BACKUP_PATHS="/srv/nas /srv/fast/dumps"
# Đường dẫn tạo lại được, không cần backup (thumbnail, video đã encode của Immich)
BACKUP_EXCLUDE_PATHS=""
RESTIC_KEEP="--keep-daily 7 --keep-weekly 4 --keep-monthly 12"

# ---------- Giám sát ----------
DISK_WARN_PCT=80
