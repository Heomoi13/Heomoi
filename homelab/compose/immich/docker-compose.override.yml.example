# GIAI ĐOẠN 4.0 — Ảnh gốc Immich chuyển vào /srv/nas/immich (sau cutover là NAS),
# còn thumbnail ở lại SSD để đọc nhanh (tạo lại được, không cần backup).
#
# KHÔNG thêm dòng encoded-video ở đây: compose hiện tại đã mount
#   /srv/nas/share/immich-encoded -> /data/encoded-video
# Trùng đích mount sẽ làm compose báo lỗi. Thêm dòng thumbs vào CÙNG chỗ đang khai báo
# mount encoded-video (docker-compose.yml hoặc override có sẵn).
#
# "/data" là đường dẫn trong container của UPLOAD_LOCATION (bản Immich cũ: /usr/src/app/upload).
services:
  immich-server:
    volumes:
      - /home/namdo/immich/library/thumbs:/data/thumbs
